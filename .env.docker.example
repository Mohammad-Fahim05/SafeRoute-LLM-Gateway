# ==============================================================================
# SafeRoute LLM Gateway - Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env.docker or merge with .env when running via docker compose.
# Command: docker compose --env-file .env.docker up -d

# Application Environment
APP_ENV=production
LOG_LEVEL=INFO

# Port mappings on host machine
GATEWAY_PORT=8000
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Authentication (HMAC-SHA256)
# ------------------------------------------------------------------------------
# Generate secret: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_ENABLED=true
AUTH_SECRET=your_minimum_16_character_secret_here

# Client key verifiers in JSON format
# Generate key & verifier: python scripts/manage_keys.py create --client-id local_dev
CLIENT_KEYS=[{"client_id": "local_dev", "verifier": "your_verifier_hex_here", "enabled": true}]

# ------------------------------------------------------------------------------
# Provider Configuration (Local Host Ollama)
# ------------------------------------------------------------------------------
ACTIVE_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_MODEL=llama3.2:1b
PROVIDER_TIMEOUT_SECONDS=30.0
ALLOWED_MODELS=["mock-model","llama3.2:1b","qwen2.5-coder:7b-instruct-q4_K_M"]

# ------------------------------------------------------------------------------
# Storage & Persistence (Inside Container)
# ------------------------------------------------------------------------------
# Database stored in named volume /app/data
DATABASE_URL=sqlite:////app/data/saferoute.db
DATABASE_STRICT_MODE=false

# ------------------------------------------------------------------------------
# Redis Cache & Rate Limiting (Compose service name 'redis')
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_NAMESPACE=v1
CACHE_FAILURE_POLICY=fail_open

# Semantic similarity caching (optional)
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_EMBEDDING_PROVIDER=mock

# Redis client rate limiting (optional)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Prometheus Metrics & Observability (Phase 11B)
METRICS_ENABLED=true
METRICS_REQUIRE_AUTH=false
# METRICS_AUTH_TOKEN=

# Streaming & Streaming Cache Replay (Phase 9.2 & Phase 11C)
STREAMING_ENABLED=true
STREAMING_CACHE_REPLAY_ENABLED=true
