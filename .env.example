# SafeRoute LLM Gateway Configuration Example
# Copy this file to .env to customize settings

# Application Environment (development, staging, production, test)
APP_ENV=development

# ------------------------------------------------------------------------------
# Authentication (Phase 2)
# ------------------------------------------------------------------------------
# Enable or disable client API-key authentication (must be true for normal operation)
AUTH_ENABLED=true

# Server-side secret used to compute and verify HMAC-SHA256 digests of client API keys
# Must be at least 16 characters long. Generate a strong random secret!
AUTH_SECRET=example_gateway_hmac_secret_at_least_16_chars_long

# Configured client keys in JSON array format.
# Generate new client entries using: python scripts/manage_keys.py create --client-id <name>
# Never store plaintext keys here - only store verifiers!
CLIENT_KEYS='[{"client_id": "dev_client_1", "verifier": "938234e76a7ba60007f0f14532dba5cba9715e605feb4dfa3d0c415e604dee44", "enabled": true}]'

# ------------------------------------------------------------------------------
# Model & Provider Configuration
# ------------------------------------------------------------------------------
# Active provider: "mock" or "ollama"
ACTIVE_PROVIDER=mock

# Local Ollama service base URL and default model
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=mock-model

# Comma-separated list of permitted model identifiers (local Ollama and mock models)
ALLOWED_MODELS=mock-model,mock-timeout,mock-error,mock-malformed,llama3.2:1b,qwen2.5-coder:7b-instruct-q4_K_M,llama3.2,phi3,mistral

# ------------------------------------------------------------------------------
# Safety, Limits, and Logging
# ------------------------------------------------------------------------------
MAX_REQUEST_SIZE_BYTES=1048576
MAX_MESSAGES_PER_REQUEST=50
MAX_COMPLETION_TOKENS_LIMIT=4096
PROVIDER_TIMEOUT_SECONDS=30.0
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Persistent SQLite Database & Usage Tracking (Phase 3)
# ------------------------------------------------------------------------------
# SQLAlchemy SQLite database URL
# Relative paths are evaluated from the project root; data directory will be auto-created.
DATABASE_URL=sqlite:///./data/saferoute.db

# Database failure mode:
# If false (resilient mode), database persistence errors are logged but the client still
# receives their model completion.
# If true (strict mode), database persistence failures abort the request with HTTP 500.
DATABASE_STRICT_MODE=false

# ------------------------------------------------------------------------------
# Redis & Exact-Match Response Caching (Phase 4)
# ------------------------------------------------------------------------------
# Connection URL for Redis cache backend (supports authentication: redis://:pass@host:port/db)
REDIS_URL=redis://localhost:6379/0

# Master toggle for exact-match response caching (defaults to false until explicitly enabled)
CACHE_ENABLED=false

# Time-To-Live in seconds for stored cached completions (e.g. 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Cache namespace / schema version (incrementing invalidates previous cache entries safely)
CACHE_NAMESPACE=v1

# Cache outage failure policy:
# "fail_open" (recommended): Redis read/write errors are logged as warnings and the gateway
# falls back directly to the AI provider.
# "fail_closed": Redis errors fail the incoming request with HTTP 500.
CACHE_FAILURE_POLICY=fail_open

# ------------------------------------------------------------------------------
# Semantic Response Caching (Phase 9.4)
# ------------------------------------------------------------------------------
# Master toggle for semantic response caching (optional second-level cache after exact cache)
SEMANTIC_CACHE_ENABLED=false

# Minimum cosine similarity threshold (0.0 to 1.0) required to consider a prior response reusable
SEMANTIC_CACHE_THRESHOLD=0.85

# Time-To-Live in seconds for stored semantic cache entries
SEMANTIC_CACHE_TTL_SECONDS=300

# Embedding provider: "local" (uses SentenceTransformer offline), "mock", or "sentence_transformers"
SEMANTIC_CACHE_EMBEDDING_PROVIDER=local

# Embedding model identifier recorded with each stored vector
SEMANTIC_CACHE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding version tag (incrementing invalidates mismatched vectors safely)
SEMANTIC_CACHE_EMBEDDING_VERSION=v1

# Maximum candidate vectors scanned per tenant and model
SEMANTIC_CACHE_MAX_CANDIDATES=100

# Strict temperature matching tolerance (0.0 requires exact match)
SEMANTIC_CACHE_TEMPERATURE_TOLERANCE=0.0

# Failure policy for semantic caching ("fail_open" or "fail_closed")
SEMANTIC_CACHE_FAILURE_POLICY=fail_open

# ------------------------------------------------------------------------------
# Redis-Backed Client Rate Limiting (Phase 5)
# ------------------------------------------------------------------------------
# Master toggle for client rate limiting (default: false until explicitly enabled)
RATE_LIMIT_ENABLED=false

# Global allowed requests per window for authenticated clients
RATE_LIMIT_REQUESTS=60

# Rate limit window duration in seconds (default: 60 = 1 minute)
RATE_LIMIT_WINDOW_SECONDS=60

# Rate limiting key namespace / schema version (prevents key collisions)
RATE_LIMIT_NAMESPACE=v1

# Rate limiting failure policy when Redis is unavailable:
# "fail_closed" (secure default): Rejects requests with HTTP 503 Service Unavailable
# to protect downstream providers from overload.
# "fail_open": Permits requests through to the provider when Redis is unavailable.
# ------------------------------------------------------------------------------
# Configurable Input and Output Guardrails (Phase 6)
# ------------------------------------------------------------------------------
# Master toggle for deterministic guardrails (defaults to false until enabled)
GUARDRAILS_ENABLED=false

# Stage toggles when GUARDRAILS_ENABLED=true
GUARDRAILS_INPUT_ENABLED=true
GUARDRAILS_OUTPUT_ENABLED=true

# Policy action when a rule matches (currently supported: "block")
GUARDRAILS_ACTION=block

# Maximum character length per message/completion to protect against pathological regex / ReDoS
GUARDRAILS_MAX_TEXT_LENGTH=100000

# Guardrail rules in JSON array format.
# Supported fields per rule:
# - rule_id (str, required): Unique identifier for audit logging
# - pattern (str, required): The string, regex pattern, or word to match
# - match_type (str, optional): "regex", "contains", or "keyword" (default: "regex")
# - stage (str, optional): "both", "input", or "output" (default: "both")
# - case_sensitive (bool, optional): Case-sensitive matching (default: false)
# Note: For regex match_type, regex patterns are compiled at gateway startup.
GUARDRAILS_RULES='[{"rule_id": "block_drop_database", "pattern": "DROP\\s+DATABASE", "match_type": "regex", "stage": "both", "case_sensitive": false}, {"rule_id": "block_mock_secret", "pattern": "SECRET_KEY_PROHIBITED", "match_type": "contains", "stage": "both", "case_sensitive": true}]'

# ------------------------------------------------------------------------------
# Semantic Safety Classification & Moderation Guardrails (Phase 9.5)
# ------------------------------------------------------------------------------
# Master toggle for semantic safety classification (complements deterministic guardrails)
SAFETY_CLASSIFIER_ENABLED=false

# Classifier provider: "local" (uses SentenceTransformer offline), "mock", "deterministic", or "disabled"
SAFETY_CLASSIFIER_PROVIDER=local

# Embedding model identifier used for semantic risk exemplar comparison
SAFETY_CLASSIFIER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum duration in seconds allocated for safety classification before timeout
SAFETY_CLASSIFIER_TIMEOUT_SECONDS=0.5

# Failure policy when classifier fails or times out: "fail_closed" (block) or "fail_open" (flag and allow)
SAFETY_CLASSIFIER_FAILURE_POLICY=fail_closed

# Risk detection thresholds (0.0 to 1.0)
SAFETY_CLASSIFIER_THRESHOLD_INJECTION=0.80
SAFETY_CLASSIFIER_THRESHOLD_HATE=0.80
SAFETY_CLASSIFIER_THRESHOLD_TOXICITY=0.80
SAFETY_CLASSIFIER_THRESHOLD_PII=0.75

# Actions per risk category: "block", "flag_and_forward", or "redact" (for PII)
SAFETY_CLASSIFIER_ACTION_INJECTION=block
SAFETY_CLASSIFIER_ACTION_HATE=block
SAFETY_CLASSIFIER_ACTION_TOXICITY=block
SAFETY_CLASSIFIER_ACTION_PII=redact

# Whether to inspect output completions generated by providers or served from cache
SAFETY_CLASSIFIER_INSPECT_OUTPUT=true

# ------------------------------------------------------------------------------
# Multi-Provider Failover Settings (Phase 9.1 & 9.1.1)
# ------------------------------------------------------------------------------
# Master switch for multi-provider failover. Defaults to false (single-provider mode).
# Per-request overrides:
#   - Header: 'X-Allow-Failover: true|false' (highest priority)
#   - Request body: '"allow_failover": true|false' (medium priority)
#   - Global setting: FAILOVER_ENABLED (baseline default)
# Per-request settings never bypass authentication, model allowlists, rate limiting, or guardrails.
FAILOVER_ENABLED=false

# Allow mock models to serve as fallbacks for real AI models.
# Security guardrail: Must be false in production. In production environments, mock fallbacks
# are strictly rejected by the gateway to prevent returning synthetic responses to real callers.
FAILOVER_ALLOW_MOCK_FALLBACK=false

# Maximum total attempts per request (including initial primary attempt and fallbacks).
FAILOVER_MAX_ATTEMPTS=3

# Overall timeout budget across all attempts in seconds. If exceeded, failover terminates.
FAILOVER_TIMEOUT_BUDGET_SECONDS=15.0

# Base retry delay between failover attempts in seconds.
FAILOVER_RETRY_DELAY_SECONDS=0.5

# Maximum ceiling for Retry-After hints or backoff delays in seconds.
FAILOVER_MAX_RETRY_DELAY_SECONDS=5.0

# Fallback models mapping in JSON dictionary format (or comma-separated list for default).
# Maps requested model IDs to an ordered list of allowed fallback model IDs.
# Example: '{"llama3.2:1b": ["mistral"]}'
FAILOVER_FALLBACK_MODELS='{"llama3.2:1b": ["mistral"]}'

# Upstream HTTP status codes classified as eligible for automatic failover.
FAILOVER_ELIGIBLE_STATUS_CODES=429,500,502,503,504

# Error codes classified as eligible for automatic failover.
FAILOVER_ELIGIBLE_ERROR_CODES=gateway_timeout,provider_error,provider_rate_limit_error,bad_gateway,service_unavailable

# ------------------------------------------------------------------------------
# Streaming Responses (Phase 9.2) & Streaming Cache Replay (Phase 11C)
# ------------------------------------------------------------------------------
# Master toggle for streaming chat completions (Content-Type: text/event-stream)
STREAMING_ENABLED=true

# Replay compatible cached responses safely for requests with stream=true (default: true)
# When enabled, compatible completed responses are cached and replayed as SSE event streams,
# eliminating redundant provider inferences without double-counting tokens or request metrics.
STREAMING_CACHE_REPLAY_ENABLED=true

# ------------------------------------------------------------------------------
# Prometheus Metrics & Observability (Phase 11B)
# ------------------------------------------------------------------------------
# Enable standard Prometheus metrics endpoint at GET /metrics
METRICS_ENABLED=true

# Require authentication for /metrics scraping (default false for private internal networks)
# If true, requires Bearer token matching METRICS_AUTH_TOKEN or a valid registered client key
METRICS_REQUIRE_AUTH=false

# Optional dedicated secret bearer token for metrics scraping
# METRICS_AUTH_TOKEN=your-prometheus-scraper-token-here
