# SafeRoute LLM Gateway Configuration Example
# Copy this file to .env to customize settings

# Application Environment (development, staging, production, test)
APP_ENV=development

# Comma-separated list of allowed model identifiers
ALLOWED_MODELS=mock-model,mock-timeout,mock-error,mock-malformed

# Default model when not explicitly provided (if applicable)
DEFAULT_MODEL=mock-model

# Safety and validation limits
MAX_REQUEST_SIZE_BYTES=1048576
MAX_MESSAGES_PER_REQUEST=50
MAX_COMPLETION_TOKENS_LIMIT=4096

# Provider timeout in seconds
PROVIDER_TIMEOUT_SECONDS=5.0

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
